# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » à la RACINE du repo avant `docker compose up`.
# Ne commitez JAMAIS le fichier .env (déjà couvert par les .gitignore existants).
#
# Ce fichier alimente docker-compose.yml (services `backend` + `mysql`).
# Les variables PAYFLEX_*/PAYDUNYA_* reprennent EXACTEMENT les noms déjà
# utilisés par payflex_backend/.env.example (même backend, même configuration
# Spring) — voir ce fichier pour la description détaillée de chaque clé.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MySQL (service `mysql` du docker-compose) — image officielle mysql:8
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=payflexdb
MYSQL_USER=payflex
MYSQL_PASSWORD=changeme-payflex

# ---------------------------------------------------------------------------
# Backend — connexion base de données.
# Doit rester cohérent avec les valeurs MySQL ci-dessus. L'hôte "mysql" est le
# nom du service docker-compose (résolution DNS interne au réseau compose) ;
# ne pas remplacer par "localhost" quand le backend tourne dans le conteneur.
# ---------------------------------------------------------------------------
PAYFLEX_DB_URL=jdbc:mysql://mysql:3306/payflexdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PAYFLEX_DB_USER=payflex
PAYFLEX_DB_PASSWORD=changeme-payflex

# ---------------------------------------------------------------------------
# Backend — divers (détail de chaque variable : payflex_backend/.env.example)
# ---------------------------------------------------------------------------
PAYFLEX_PUBLIC_URL=http://localhost:8088
PAYFLEX_VAULT_KEY=payflex-dev-vault-key-change-me
PAYFLEX_CATCHUP_ALERT_THRESHOLD=5
PAYFLEX_AUTO_VALIDATE_HOURS=24
PAYFLEX_AGENT_CASH_AUTO_VALIDATE=false
PAYFLEX_LOG_DIR=logs

# Notifications push réelles (optionnel — voir payflex_mobile/PAYFLEX_PUSH.md).
# Vides = repli automatique sur le modèle « pull » (poll mobile + inbox admin).
PAYFLEX_FIREBASE_CREDENTIALS=
PAYFLEX_VAPID_PUBLIC_KEY=
PAYFLEX_VAPID_PRIVATE_KEY=
PAYFLEX_VAPID_SUBJECT=mailto:support@payflex.app

# ---------------------------------------------------------------------------
# PayDunya (passerelle mobile money unique — voir payflex_backend/PAYDUNYA.md)
# Repli gracieux : clés vides = mobile money masqué côté mobile.
# ---------------------------------------------------------------------------
PAYDUNYA_ENABLED=true
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_PUBLIC_KEY=
