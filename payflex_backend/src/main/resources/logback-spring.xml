<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Logs JSON structurés (Logstash encoder) : désactivés par défaut pour ne pas casser le
         confort du dev local (texte lisible en console + fichiers texte ci-dessous, avec leur
         rotation déjà en place). Activés uniquement si PAYFLEX_LOG_JSON=true (typiquement en
         prod / derrière un collecteur de logs). Écrit sur STDOUT plutôt que sur un fichier
         séparé : le plus simple à brancher sur un agrégateur de logs container/systemd sans
         dupliquer la logique de rotation déjà gérée par ERROR_FILE/DIAGNOSTIC_FILE/MOBILE_API_FILE
         ci-dessous. -->
    <property name="payflexLogJson" value="${PAYFLEX_LOG_JSON:-false}"/>

  <!-- Chemins configurables dans application.yml (payflex.logging.*) -->
    <!-- Dossier de logs dédié : hors racine projet, configurable via PAYFLEX_LOG_DIR -->
    <springProperty scope="context" name="payflexLogDir"
                    source="payflex.logging.log-dir" defaultValue="logs"/>
    <springProperty scope="context" name="payflexErrorLogFile"
                    source="payflex.logging.error-log-file" defaultValue="erreur.log"/>
    <springProperty scope="context" name="payflexDiagnosticLogFile"
                    source="payflex.logging.diagnostic-log-file" defaultValue="diagnostic.log"/>
    <springProperty scope="context" name="payflexMobileApiLogFile"
                    source="payflex.logging.mobile-api-log-file" defaultValue="mobile-api.log"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JSON structuré (un objet JSON par ligne sur STDOUT) — actif uniquement si
         PAYFLEX_LOG_JSON=true. Ne remplace pas CONSOLE/ERROR_FILE/DIAGNOSTIC_FILE/
         MOBILE_API_FILE : s'ajoute en plus, pour un agrégateur de logs externe. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- ERROR uniquement — stack traces complètes -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${payflexLogDir}/${payflexErrorLogFile}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${payflexLogDir}/${payflexErrorLogFile}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- WARN + ERROR — connexions refusées, login échoué, SQL, etc. -->
    <appender name="DIAGNOSTIC_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${payflexLogDir}/${payflexDiagnosticLogFile}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${payflexLogDir}/${payflexDiagnosticLogFile}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- API mobile : tentatives login, inscription, erreurs métier -->
    <appender name="MOBILE_API_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${payflexLogDir}/${payflexMobileApiLogFile}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${payflexLogDir}/${payflexMobileApiLogFile}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <logger name="com.payflex.backend.controller.MobileApiController" level="INFO" additivity="false">
        <appender-ref ref="MOBILE_API_FILE"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="DIAGNOSTIC_FILE"/>
    </logger>

    <logger name="com.payflex.backend.service.MobileApiService" level="DEBUG" additivity="false">
        <appender-ref ref="MOBILE_API_FILE"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="DIAGNOSTIC_FILE"/>
    </logger>

    <logger name="com.payflex.backend.controller.PayDunyaWebhookController" level="INFO" additivity="false">
        <appender-ref ref="MOBILE_API_FILE"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="DIAGNOSTIC_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="DIAGNOSTIC_FILE"/>
        <if condition='property("payflexLogJson").equalsIgnoreCase("true")'>
            <then>
                <appender-ref ref="JSON_CONSOLE"/>
            </then>
        </if>
    </root>
</configuration>
